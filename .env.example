# Copy this file to .env and fill in your values

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI (for future use)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Anthropic (for future use)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: OpenAI-compatible custom endpoint (local Ollama/LM Studio/vLLM or
# any hosted OpenAI-compatible API). Optional for local servers that ignore
# auth. The env var name can be changed via ai.openai_compatible.api_key_env.
OPENAI_COMPATIBLE_API_KEY=
